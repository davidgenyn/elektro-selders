---
layout: base.njk
seoKey: diensten
permalink: /diensten/
---
<section class="pagetitle"><div class="wrap"><h1>Diensten</h1><p>{{ diensten.intro }}</p></div></section>
<div class="wrap">
{% for g in diensten.groepen %}
<section class="dienst" id="{{ g.id }}"><h2>{{ g.titel }}</h2><p>{{ g.tekst }}</p><ul>{% for i in g.items %}<li>{{ i }}</li>{% endfor %}</ul>{% if g.link %}<p><a class="more" href="{{ g.link }}">Meer over {{ g.titel | lower }} ›</a></p>{% endif %}</section>
{% endfor %}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for f in diensten.faq %}{"@type":"Question","name":{{ f.vraag | dump | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ f.antwoord | dump | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}</script>
<section class="section"><h2>{{ diensten.faq_titel }}</h2>
{% for f in diensten.faq %}<details><summary>{{ f.vraag }}</summary><p>{{ f.antwoord }}</p></details>{% endfor %}
<p style="margin-top:2rem"><a class="btn" href="/contact/">Gratis offerte aanvragen</a></p>
</section>
</div>
